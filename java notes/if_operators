public class if_operators{
    public static void main(String[] args) {
    

    int basta = 12;
    System.out.println(basta);
    String bastaz = "Dan Gallenero";
    System.out.println(bastaz);
    int myNum;
    myNum = 90; 
    
    if(myNum > bastaz.length() && myNum== 90){
        System.out.println("HEEELLLLLLOOOOOOOO");
    }
    else if(myNum<bastaz.length()){
        System.out.println("YOOSHAAAA");
    }
    else{
        System.out.println("GOOODDDBYEEE");
    }
    
   ora();
   Switch();
}

  static void ora(){
    System.out.println("tjtjtjjjtjtjtj");
}



public static void Switch(){
    int aguy = 12;
    switch(aguy){
        case 11 -> System.out.println("dede");
        default -> {
            System.out.println("oraaa");
        }
    }
}

}


